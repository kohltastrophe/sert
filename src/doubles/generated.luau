export type Param = { name: string, type: string, optional: boolean }
export type Property = {
	name: string,
	owner: string,
	type: string,
	category: string,
	typeName: string,
	readOnly: boolean,
	writeOnly: boolean,
	deprecated: boolean,
	plugin: boolean,
	notReplicated: boolean,
	default: string?,
}
export type Event = { name: string, owner: string, params: { Param }, deprecated: boolean, plugin: boolean }
export type Function = {
	name: string,
	owner: string,
	params: { Param },
	returns: { string },
	deprecated: boolean,
	plugin: boolean,
	yields: boolean,
}
export type Members = {
	properties: { [string]: Property },
	events: { [string]: Event },
	functions: { [string]: Function },
	callbacks: { [string]: Function },
}
export type Class = { name: string, superclass: string?, tags: { [string]: boolean }, own: Members }
export type EnumItem = { Name: string, Value: number }

local CLASS_TAGS: { [string]: string } = {
	C = "NotCreatable",
	S = "Service",
	A = "Abstract",
	D = "Deprecated",
	B = "NotBrowsable",
	N = "NotReplicated",
	P = "PlayerReplicated",
}
local PRIMITIVES: { [string]: boolean } = {
	bool = true,
	int = true,
	int64 = true,
	float = true,
	double = true,
	string = true,
	null = true,
	void = true,
}
local GROUPS: { [string]: boolean } = {
	Tuple = true,
	Array = true,
	["Array?"] = true,
	Dictionary = true,
	["Dictionary?"] = true,
	Map = true,
	Variant = true,
}

local Generated = {}

local function split(text: string, sep: string): { string }
	local out, start = {}, 1
	while true do
		local at = string.find(text, sep, start, true)
		if at == nil then
			table.insert(out, string.sub(text, start))
			return out
		end
		table.insert(out, string.sub(text, start, at - 1))
		start = at + #sep
	end
end

local function categorize(t: string): (string, string)
	if string.sub(t, 1, 5) == "Enum." then
		return "Enum", string.sub(t, 6)
	elseif string.sub(t, 1, 1) == "@" then
		return "Class", string.sub(t, 2)
	elseif PRIMITIVES[t] then
		return "Primitive", t
	elseif GROUPS[t] then
		return "Group", t
	end
	return "DataType", t
end

local function parseParams(text: string): { Param }
	local out: { Param } = {}
	if text == "" then return out end
	for _, entry in split(text, ",") do
		local colon = string.find(entry, ":", 1, true) or (#entry + 1)
		local name = string.sub(entry, 1, colon - 1)
		local optional = string.sub(name, -1) == "?"
		if optional then name = string.sub(name, 1, -2) end
		table.insert(out, { name = name, type = string.sub(entry, colon + 1), optional = optional })
	end
	return out
end

local function hasFlag(flags: string, flag: string): boolean return string.find(flags, flag, 1, true) ~= nil end

local function emptyMembers(): Members return { properties = {}, events = {}, functions = {}, callbacks = {} } end

local parsed: { [string]: Class } = {}

local function parseClass(name: string): Class?
	local found = parsed[name]
	if found ~= nil then return found end
	local encoded = CLASSES[name]
	if encoded == nil then return nil end
	local lines = split(encoded, ";")
	local head = split(lines[1], "|")
	local tags: { [string]: boolean } = {}
	for index = 1, #head[2] do
		local tag = CLASS_TAGS[string.sub(head[2], index, index)]
		if tag ~= nil then tags[tag] = true end
	end
	local own = emptyMembers()
	for index = 2, #lines do
		local line = lines[index]
		local kind = string.sub(line, 1, 1)
		local fields = split(string.sub(line, 3), "|")
		local memberName = fields[1]
		if kind == "P" then
			local category, typeName = categorize(fields[2])
			local flags = fields[3]
			local default: string? = if #fields >= 4 then table.concat(fields, "|", 4) else nil
			if default == "" then default = nil end
			own.properties[memberName] = {
				name = memberName,
				owner = name,
				type = fields[2],
				category = category,
				typeName = typeName,
				readOnly = hasFlag(flags, "r"),
				writeOnly = hasFlag(flags, "w"),
				deprecated = hasFlag(flags, "d"),
				plugin = hasFlag(flags, "p"),
				notReplicated = hasFlag(flags, "n"),
				default = default,
			}
		elseif kind == "E" then
			local flags = fields[2]
			own.events[memberName] = {
				name = memberName,
				owner = name,
				params = parseParams(fields[3] or ""),
				deprecated = hasFlag(flags, "d"),
				plugin = hasFlag(flags, "p"),
			}
		elseif kind == "F" or kind == "C" then
			local flags, returns = fields[2], fields[4] or ""
			local fn: Function = {
				name = memberName,
				owner = name,
				params = parseParams(fields[3] or ""),
				returns = if returns == "" then {} else split(returns, ","),
				deprecated = hasFlag(flags, "d"),
				plugin = hasFlag(flags, "p"),
				yields = hasFlag(flags, "y"),
			}
			if kind == "F" then
				own.functions[memberName] = fn
			else
				own.callbacks[memberName] = fn
			end
		end
	end
	local class: Class = { name = name, superclass = if head[1] == "" then nil else head[1], tags = tags, own = own }
	parsed[name] = class
	return class
end

function Generated.exists(name: string): boolean return CLASSES[name] ~= nil end

function Generated.class(name: string): Class? return parseClass(name) end

function Generated.superclass(name: string): string?
	local class = parseClass(name)
	return if class ~= nil then class.superclass else nil
end

local ancestry: { [string]: { [string]: boolean } } = {}

function Generated.isA(className: string, base: string): boolean
	local set = ancestry[className]
	if set == nil then
		set = {}
		local cur: string? = className
		while cur ~= nil and CLASSES[cur] ~= nil do
			set[cur] = true
			cur = Generated.superclass(cur)
		end
		ancestry[className] = set
	end
	return set[base] == true
end

function Generated.chain(className: string): { string }
	local out, cur: string? = {}, className
	while cur ~= nil and CLASSES[cur] ~= nil do
		table.insert(out, cur)
		cur = Generated.superclass(cur)
	end
	return out
end

local merged: { [string]: Members } = {}

function Generated.members(className: string): Members
	local found = merged[className]
	if found ~= nil then return found end
	local out = emptyMembers()
	local chain = Generated.chain(className)
	for index = #chain, 1, -1 do
		local class = parseClass(chain[index]) :: Class
		for name, info in class.own.properties do
			out.properties[name] = info
		end
		for name, info in class.own.events do
			out.events[name] = info
		end
		for name, info in class.own.functions do
			out.functions[name] = info
		end
		for name, info in class.own.callbacks do
			out.callbacks[name] = info
		end
	end
	merged[className] = out
	return out
end

function Generated.property(className: string, name: string): Property?
	return Generated.members(className).properties[name]
end

function Generated.event(className: string, name: string): Event? return Generated.members(className).events[name] end

function Generated.method(className: string, name: string): Function?
	return Generated.members(className).functions[name]
end

function Generated.callback(className: string, name: string): Function?
	return Generated.members(className).callbacks[name]
end

function Generated.tags(name: string): { [string]: boolean }
	local class = parseClass(name)
	return if class ~= nil then class.tags else {}
end

function Generated.creatable(name: string): boolean
	local class = parseClass(name)
	return class ~= nil and not class.tags.NotCreatable
end

function Generated.isService(name: string): boolean
	local class = parseClass(name)
	return class ~= nil and class.tags.Service == true
end

function Generated.isAbstract(name: string): boolean
	local class = parseClass(name)
	return class ~= nil and class.tags.Abstract == true
end

local function sortedKeys(source: { [string]: string }): { string }
	local out = {}
	for name in source do
		table.insert(out, name)
	end
	table.sort(out)
	return out
end

function Generated.classNames(): { string } return sortedKeys(CLASSES) end

type ParsedEnum = { items: { EnumItem }, byName: { [string]: EnumItem } }
local parsedEnums: { [string]: ParsedEnum } = {}

local function parseEnum(name: string): ParsedEnum?
	local found = parsedEnums[name]
	if found ~= nil then return found end
	local encoded = ENUMS[name]
	if encoded == nil then return nil end
	local items: { EnumItem }, byName: { [string]: EnumItem }, byValue: { [number]: EnumItem }, aliases: { { string } } =
		{}, {}, {}, {}
	for _, entry in split(encoded, ";") do
		local itemName, value = string.match(entry, "^([^=]+)=(-?%d+)")
		if itemName ~= nil and value ~= nil then
			if string.sub(entry, -1) == "!" then
				table.insert(aliases, { itemName, value })
			else
				local item: EnumItem = { Name = itemName, Value = tonumber(value) :: number }
				table.insert(items, item)
				byName[itemName] = item
				byValue[item.Value] = byValue[item.Value] or item
			end
		end
	end
	for _, alias in aliases do
		byName[alias[1]] = byValue[tonumber(alias[2]) :: number]
	end
	local result = { items = table.freeze(items), byName = byName }
	parsedEnums[name] = result
	return result
end

function Generated.enum(name: string): { EnumItem }?
	local found = parseEnum(name)
	return if found ~= nil then found.items else nil
end

function Generated.enumItem(name: string, item: string): EnumItem?
	local found = parseEnum(name)
	return if found ~= nil then found.byName[item] else nil
end

function Generated.enumNames(): { string } return sortedKeys(ENUMS) end

local function parseNumbers(text: string): { number }
	local out = {}
	for _, part in split(text, ",") do
		local val = if part == "inf" then math.huge elseif part == "-inf" then -math.huge else tonumber(part) or 0
		table.insert(out, val)
	end
	return out
end

local function unescape(text: string): string
	return (
		string.gsub(text, "%%(%x%x)", function(hex: string): string return string.char(tonumber(hex, 16) :: number) end)
	)
end

function Generated.defaultValue(className: string, name: string, ctx: any): any
	local info = Generated.property(className, name)
	if info == nil or info.default == nil then return nil end
	local raw = info.default :: string
	local category, typeName = info.category, info.typeName
	if category == "Primitive" then
		if typeName == "bool" then
			return raw == "true"
		elseif typeName == "string" then
			return unescape(string.sub(raw, 2))
		end
		return parseNumbers(raw)[1]
	elseif category == "Enum" then
		local enumType = ctx.Enum and ctx.Enum[typeName]
		return if enumType ~= nil then enumType[raw] else nil
	elseif typeName == "ContentId" then
		return unescape(string.sub(raw, 2))
	end
	local ctor = ctx[typeName]
	if ctor == nil then return nil end
	if typeName == "Axes" or typeName == "Faces" then
		local enumType = ctx.Enum and ctx.Enum[if typeName == "Axes" then "Axis" else "NormalId"]
		local args = {}
		if raw ~= "-" then
			for _, part in split(raw, ",") do
				table.insert(args, enumType[part])
			end
		end
		return ctor.new(table.unpack(args))
	elseif typeName == "TweenInfo" then
		local f = split(raw, ",")
		return ctor.new(
			tonumber(f[1]),
			ctx.Enum.EasingStyle[f[2]],
			ctx.Enum.EasingDirection[f[3]],
			tonumber(f[4]),
			f[5] == "true",
			tonumber(f[6])
		)
	end
	local n = parseNumbers(raw)
	if typeName == "UDim2" then
		return ctor.new(n[1], n[2], n[3], n[4])
	elseif typeName == "Ray" then
		return ctor.new(ctx.Vector3.new(n[1], n[2], n[3]), ctx.Vector3.new(n[4], n[5], n[6]))
	elseif typeName == "NumberSequence" then
		local keypoints: { any } = {}
		for index = 1, #n, 3 do
			table.insert(keypoints, (ctx.NumberSequenceKeypoint.new(n[index], n[index + 1], n[index + 2])))
		end
		return ctor.new(keypoints)
	elseif typeName == "ColorSequence" then
		local keypoints: { any } = {}
		for index = 1, #n, 5 do
			local color = ctx.Color3.new(n[index + 1], n[index + 2], n[index + 3])
			table.insert(keypoints, (ctx.ColorSequenceKeypoint.new(n[index], color)))
		end
		return ctor.new(keypoints)
	end
	return ctor.new(table.unpack(n))
end

return table.freeze(Generated)
