{
	"name": "sert Runner example",
	"emitLegacyScripts": false,
	"tree": {
		"$className": "DataModel",
		"ReplicatedStorage": {
			"sert": {
				"$path": "../../src"
			},
			"Tests": {
				"$className": "Folder",
				"Config": {
					"$path": "Config.luau"
				},
				"specs": {
					"$path": "specs"
				}
			}
		},
		"ServerScriptService": {
			"sert.Runner": {
				"$path": "server.server.luau"
			}
		},
		"ReplicatedFirst": {
			"sert.Runner": {
				"$path": "client.client.luau"
			}
		}
	}
}
